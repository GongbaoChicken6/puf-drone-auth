<?xml version="1.0" encoding="UTF-8"?>
<!-- Synthetic but structurally faithful mini .hwh (Vivado-style system graph)
     for offline testing of the skill scripts. Two addressable IPs. -->
<EDKSYSTEM EDKVERSION="2026.1" TIMESTAMP="2026-10-14T00:00:00Z">
  <MODULES>
    <MODULENODE>
      <FULLNAME>/speck_cipher_0</FULLNAME>
      <IPSTRUCT>xilinx.com:user:speck_cipher:1.0</IPSTRUCT>
      <MEMRANGES>
        <MEMRANGE>
          <BASEVALUE>0x43C00000</BASEVALUE>
          <HIGHVALUE>0x43C0FFFF</HIGHVALUE>
        </MEMRANGE>
      </MEMRANGES>
      <PARAMETERS>
        <PARAMETER>
          <PARAMETERNAME>C_NUM_REG</PARAMETERNAME>
          <PARAMETERVALUE>8</PARAMETERVALUE>
        </PARAMETER>
        <PARAMETER>
          <PARAMETERNAME>C_BLOCK_BITS</PARAMETERNAME>
          <PARAMETERVALUE>32</PARAMETERVALUE>
        </PARAMETER>
      </PARAMETERS>
      <REGISTERS>
        <REGISTER>
          <NAME>ctrl</NAME>
          <ADDRESSOFFSET>0</ADDRESSOFFSET>
          <SIZE>32</SIZE>
          <ACCESS>read-write</ACCESS>
          <FIELDS>
            <FIELD>
              <NAME>AP_START</NAME>
              <BITOFFSET>0</BITOFFSET>
              <BITWIDTH>1</BITWIDTH>
              <ACCESS>read-write</ACCESS>
            </FIELD>
            <FIELD>
              <NAME>AP_DONE</NAME>
              <BITOFFSET>1</BITOFFSET>
              <BITWIDTH>1</BITWIDTH>
              <ACCESS>read-only</ACCESS>
            </FIELD>
          </FIELDS>
        </REGISTER>
        <REGISTER>
          <NAME>key_lo</NAME>
          <ADDRESSOFFSET>4</ADDRESSOFFSET>
          <SIZE>32</SIZE>
          <ACCESS>read-write</ACCESS>
          <FIELDS>
            <FIELD>
              <NAME>key_lo</NAME>
              <BITOFFSET>0</BITOFFSET>
              <BITWIDTH>32</BITWIDTH>
              <ACCESS>read-write</ACCESS>
            </FIELD>
          </FIELDS>
        </REGISTER>
        <REGISTER>
          <NAME>status</NAME>
          <ADDRESSOFFSET>8</ADDRESSOFFSET>
          <SIZE>32</SIZE>
          <ACCESS>read-only</ACCESS>
          <FIELDS>
            <FIELD>
              <NAME>busy</NAME>
              <BITOFFSET>0</BITOFFSET>
              <BITWIDTH>1</BITWIDTH>
              <ACCESS>read-only</ACCESS>
            </FIELD>
          </FIELDS>
        </REGISTER>
        <REGISTER>
          <NAME>result_lo</NAME>
          <ADDRESSOFFSET>12</ADDRESSOFFSET>
          <SIZE>32</SIZE>
          <ACCESS>read-only</ACCESS>
          <FIELDS>
            <FIELD>
              <NAME>result_lo</NAME>
              <BITOFFSET>0</BITOFFSET>
              <BITWIDTH>32</BITWIDTH>
              <ACCESS>read-only</ACCESS>
            </FIELD>
          </FIELDS>
        </REGISTER>
      </REGISTERS>
    </MODULENODE>
    <MODULENODE>
      <FULLNAME>/axi_gpio_0</FULLNAME>
      <IPSTRUCT>xilinx.com:ip:axi_gpio:2.0</IPSTRUCT>
      <MEMRANGES>
        <MEMRANGE>
          <BASEVALUE>0x41200000</BASEVALUE>
          <HIGHVALUE>0x4120FFFF</HIGHVALUE>
        </MEMRANGE>
      </MEMRANGES>
      <PARAMETERS>
        <PARAMETER>
          <PARAMETERNAME>C_ALL_INPUTS</PARAMETERNAME>
          <PARAMETERVALUE>0</PARAMETERVALUE>
        </PARAMETER>
        <PARAMETER>
          <PARAMETERNAME>C_GPIO_WIDTH</PARAMETERNAME>
          <PARAMETERVALUE>8</PARAMETERVALUE>
        </PARAMETER>
      </PARAMETERS>
    </MODULENODE>
  </MODULES>
</EDKSYSTEM>
