# ==========================================
# PUF Drone Auth .gitignore
# Principle: exclude tool-generated temp files, KEEP build scripts & reports
# ==========================================

# Vivado generated (Journals, logs, temp)
*.jou
*.log
# 证据日志必须入库（auto-review 2026-11-01：预登记/根因证据曾被 *.log 静默拦截）
!data/d1_evidence/**/*.log
*.str
*.bak
*.wdb
*.wcfg
*.cpg

# Vivado project internals (regenerated each build)
.ip_user_files/
*.runs/
*.cache/
*.sim/
*.srcs/
*.xpr
*.hw
*.gps

# Vivado design checkpoints & debug probes
*.dcp
*.ltx

# Bitstreams: too large for git, but allow in data/bitstreams/
*.bit
!data/bitstreams/*.bit

# Vivado XSA export (W2+ if needed)
*.xsa
!data/*.xsa

# Python
__pycache__/
*.pyc
*.pyo
.venv/
*.egg-info/
/dist/

# NOTE: bare "build/" pattern REMOVED - it would exclude our build/tcl/, build/ps1/, build/reports/
# Python build output is covered by "dist/" above; if using setuptools add:
# src/python/**/build/

# IDE
.idea/
.vscode/
*.swp
*.swo
*~

# OS
Thumbs.db
.DS_Store
desktop.ini

# Simulation (xsim artifacts)
xsim.dir/
xsim/*.log
glbl.v

# Data: exclude large raw datasets
data/crp_datasets/*.csv.gz
data/templates/*.pkl

# Device key store: SECRET material (Speck64/96 keys) - never commit
data/device_keys/

# Build reports: KEEP these (competition evidence)
# build/reports/*.txt   # <- UNCOMMENTED: competition requires these
# build/reports/*.rpt   # <- UNCOMMENTED: competition requires these
# Vivado journal files
*.pb
# Vivado temp
.Xil/

# Vivado workspace (repo-internal; artifacts never committed)
build/vivado/
# ZC706 board build outdir (bitstream/project/rpt live here; rpts get copied to
# build/reviews/zc706_bringup/ as evidence before any commit)
build/board_zc706/

# Frontend: teammate workspace blob (merged & tracked copy lives in web/)
web-over/
# Handoff doc stays session-local
docs/FRONTEND_HANDOFF.md
# web/dist/ is the offline deliverable -- MUST be tracked (un-ignored via /dist/ anchor above)

# Vivado MCP session state
build/vivado_mcp/.vivado-ai/
build/vivado_mcp/mcp_cmd.json

# Session-local credential-manager scratch scripts (runtime `git credential fill` helpers,
# never part of the competition deliverable; kept on disk, kept out of git)
build/create_repo.ps1
build/cred*.ps1
build/gh_auth.ps1

# Bring-up/debug Vivado projects (generated; keep only tcl/rtl debug assets under build/dbg/)
build/board_zc706_*/
# 布局变体工程产物须入库（bit/rpt/MANIFEST，auto-review 2026-11-01）
!build/board_zc706_seed2/
# Frontend generated output
web/.out/
# Vivado xsim / MCP session artifacts at repo root
/.vivado-ai/
/clockInfo.txt
